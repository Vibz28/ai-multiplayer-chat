#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage: scripts/deploy-ecs [--dry-run]

Required env:
  ECS_CLUSTER

Optional env:
  AWS_REGION             (default: us-east-1)
  ECS_BACKEND_SERVICE
  ECS_LANGGRAPH_SERVICE
  ECS_FRONTEND_SERVICE
  ECS_WORKER_RUNTIME_SERVICE
  ECS_CODEX_RUNTIME_SERVICE
  ECS_CLAUDE_RUNTIME_SERVICE
  ECS_OPENCODE_RUNTIME_SERVICE
  ECS_PI_RUNTIME_SERVICE
  DRY_RUN                (1/true/yes also enables dry-run)
USAGE
}

dry_run=false
case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --dry-run)
    dry_run=true
    shift
    ;;
esac
case "${DRY_RUN:-}" in
  1|true|TRUE|yes|YES) dry_run=true ;;
esac

region="${AWS_REGION:-us-east-1}"
cluster="${ECS_CLUSTER:-}"
if [[ -z "$cluster" ]]; then
  echo "ECS_CLUSTER is required" >&2
  exit 1
fi

backend_service="${ECS_BACKEND_SERVICE:-}"
langgraph_service="${ECS_LANGGRAPH_SERVICE:-}"
frontend_service="${ECS_FRONTEND_SERVICE:-}"
worker_runtime_service="${ECS_WORKER_RUNTIME_SERVICE:-}"
codex_runtime_service="${ECS_CODEX_RUNTIME_SERVICE:-}"
claude_runtime_service="${ECS_CLAUDE_RUNTIME_SERVICE:-}"
opencode_runtime_service="${ECS_OPENCODE_RUNTIME_SERVICE:-}"
pi_runtime_service="${ECS_PI_RUNTIME_SERVICE:-}"

if [[ -z "$backend_service" && -z "$langgraph_service" && -z "$frontend_service" && -z "$worker_runtime_service" && -z "$codex_runtime_service" && -z "$claude_runtime_service" && -z "$opencode_runtime_service" && -z "$pi_runtime_service" ]]; then
  echo "Set at least one ECS service environment variable" >&2
  exit 1
fi

update_service() {
  local service_name="$1"
  if [[ -z "$service_name" ]]; then
    return
  fi
  if $dry_run; then
    echo "[dry-run] aws ecs update-service --region \"$region\" --cluster \"$cluster\" --service \"$service_name\" --force-new-deployment"
  else
    aws ecs update-service \
      --region "$region" \
      --cluster "$cluster" \
      --service "$service_name" \
      --force-new-deployment \
      >/dev/null
    echo "Triggered deployment: $service_name"
  fi
}

update_service "$backend_service"
update_service "$langgraph_service"
update_service "$frontend_service"
update_service "$worker_runtime_service"
update_service "$codex_runtime_service"
update_service "$claude_runtime_service"
update_service "$opencode_runtime_service"
update_service "$pi_runtime_service"
