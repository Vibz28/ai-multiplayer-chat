#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="${COMPOSE_FILE:-$repo_root/compose.yaml}"
wait_timeout="${STACK_WAIT_TIMEOUT:-300}"
log_tail="${STACK_LOG_TAIL:-200}"
log_follow="${STACK_LOG_FOLLOW:-1}"

export POSTGRES_PORT="${POSTGRES_PORT:-15432}"
export REDIS_PORT="${REDIS_PORT:-16379}"
export DYNAMODB_PORT="${DYNAMODB_PORT:-18001}"
export BACKEND_PORT="${BACKEND_PORT:-18000}"
export LANGGRAPH_PORT="${LANGGRAPH_PORT:-8080}"
export FRONTEND_PORT="${FRONTEND_PORT:-5173}"

ensure_local_secrets() {
  local env_file="$repo_root/.env"
  local name
  umask 077
  touch "$env_file"
  for name in FIELDWORK_RUNTIME_TOKEN FIELDWORK_LANGGRAPH_TOKEN FIELDWORK_ROOM_TOKEN_SECRET; do
    if [[ -n "${!name:-}" ]] || grep -Eq "^${name}=.+$" "$env_file"; then
      continue
    fi
    printf '%s=%s\n' "$name" "$(openssl rand -hex 32)" >> "$env_file"
  done
}

compose() {
  (cd "$repo_root" && docker compose -f "$compose_file" "$@")
}

usage() {
  cat <<USAGE
Usage: scripts/stack <command>

Commands:
  up           Build and start the full stack (frontend + backend + langgraph + stores)
  up-core      Build and start backend/langgraph/stores only (no frontend container)
  up-telegram  Start the full stack with the optional Telegram voice-note bridge
  down         Stop and remove stack containers
  restart      Recreate full stack
  status       Show container status
  logs [svc]   Tail logs (all services or one service)
  smoke        Run health checks against backend/langgraph/frontend
  auth <name>  Sign in a harness (codex, claude, opencode, or pi)
  frontend-dev Run frontend in Bun dev mode against containerized backend
USAGE
}

health_check() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS "$url" >/dev/null
  else
    python - <<PY
import urllib.request
urllib.request.urlopen("$url")
PY
  fi
}

warn_loopback_frontend_conflict() {
  if ! command -v lsof >/dev/null 2>&1; then
    return
  fi

  local conflict
  conflict="$(lsof -nP -iTCP:"${FRONTEND_PORT}" -sTCP:LISTEN 2>/dev/null | awk '
    NR>1 {
      if ($1 != "com.docke" && index($0, "[::1]:'"${FRONTEND_PORT}"' (LISTEN)") > 0) {
        print $1 " (pid=" $2 ")"
      }
    }
  ' | head -n 1)"

  if [[ -n "$conflict" ]]; then
    echo "warning: detected local loopback listener on [::1]:${FRONTEND_PORT}: ${conflict}" >&2
    echo "warning: localhost may resolve to that process instead of Docker frontend." >&2
    echo "warning: use http://127.0.0.1:${FRONTEND_PORT} or stop the conflicting process." >&2
  fi
}

cmd="${1:-}"; shift || true

if [[ "$cmd" != "help" && "$cmd" != "--help" && "$cmd" != "-h" ]]; then
  ensure_local_secrets
fi

case "$cmd" in
  help|--help|-h)
    usage
    ;;
  up)
    "$repo_root/scripts/check-repo-hygiene"
    compose up -d --build --wait --wait-timeout "$wait_timeout"
    warn_loopback_frontend_conflict
    ;;
  up-core)
    "$repo_root/scripts/check-repo-hygiene"
    compose up -d --build --wait --wait-timeout "$wait_timeout" postgres redis dynamodb-local worker-runtime codex-runtime claude-runtime opencode-runtime pi-runtime langgraph-service backend
    ;;
  up-telegram)
    "$repo_root/scripts/check-repo-hygiene"
    compose --profile telegram up -d --build --wait --wait-timeout "$wait_timeout"
    warn_loopback_frontend_conflict
    ;;
  down)
    compose down
    ;;
  restart)
    "$repo_root/scripts/check-repo-hygiene"
    compose down
    compose up -d --build --wait --wait-timeout "$wait_timeout"
    warn_loopback_frontend_conflict
    ;;
  status|ps)
    compose ps
    ;;
  logs)
    if [[ "$log_follow" != "0" ]]; then
      if [[ $# -gt 0 ]]; then
        compose logs --tail "$log_tail" -f "$1"
      else
        compose logs --tail "$log_tail" -f
      fi
    else
      if [[ $# -gt 0 ]]; then
        compose logs --tail "$log_tail" "$1"
      else
        compose logs --tail "$log_tail"
      fi
    fi
    ;;
  smoke)
    compose ps
    compose exec -T worker-runtime curl -fsS http://localhost:8090/health >/dev/null
    compose exec -T codex-runtime curl -fsS http://localhost:8090/health >/dev/null
    compose exec -T claude-runtime curl -fsS http://localhost:8090/health >/dev/null
    compose exec -T opencode-runtime curl -fsS http://localhost:8090/health >/dev/null
    compose exec -T pi-runtime curl -fsS http://localhost:8090/health >/dev/null
    health_check "http://localhost:${BACKEND_PORT}/health"
    compose exec -T langgraph-service python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" >/dev/null
    health_check "http://localhost:${FRONTEND_PORT}/health"
    warn_loopback_frontend_conflict
    echo "Smoke checks passed:"
    echo "  frontend:  http://localhost:${FRONTEND_PORT}"
    echo "  backend:   http://localhost:${BACKEND_PORT}"
    echo "  langgraph: internal service healthy"
    ;;
  auth)
    harness="${1:-}"
    case "$harness" in
      codex)
        compose up -d --build codex-runtime
        compose exec --env HOME=/auth/codex --env CODEX_HOME=/auth/codex codex-runtime codex login --device-auth
        ;;
      claude|claude_code)
        compose up -d --build claude-runtime
        compose exec --env HOME=/auth/claude --env CLAUDE_CONFIG_DIR=/auth/claude claude-runtime claude auth login
        ;;
      opencode)
        compose up -d --build opencode-runtime
        compose exec --env HOME=/auth/opencode opencode-runtime opencode auth login --provider openai
        ;;
      pi)
        echo "Run /login in Pi, then exit when authentication is complete."
        compose up -d --build pi-runtime
        compose exec --env HOME=/auth/pi --env PI_CODING_AGENT_DIR=/auth/pi pi-runtime pi --no-extensions --no-skills
        ;;
      *)
        echo "auth requires one of: codex, claude, opencode, pi" >&2
        exit 1
        ;;
    esac
    ;;
  frontend-dev)
    if [[ "${STACK_FRONTEND_DEV_DRY_RUN:-0}" == "1" ]]; then
      echo "[dry-run] cd \"$repo_root/frontend\" && bun install && bun run dev --host 0.0.0.0 --port \"${FRONTEND_PORT}\""
      exit 0
    fi
    (cd "$repo_root/frontend" && bun install && bun run dev --host 0.0.0.0 --port "${FRONTEND_PORT}")
    ;;
  *)
    usage
    exit 1
    ;;
esac
