# Backend
BACKEND_APP_ENV=dev
BACKEND_API_TITLE=AI Multiplayer Chat Backend
BACKEND_DYNAMODB_TABLE_NAME=application_thread_mapping
BACKEND_DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
BACKEND_DYNAMODB_REGION=us-east-1
BACKEND_DYNAMODB_ACCESS_KEY_ID=dummy
BACKEND_DYNAMODB_SECRET_ACCESS_KEY=dummy
BACKEND_LANGGRAPH_SERVICE_URL=http://langgraph-service:8080
BACKEND_WORKER_RUNTIME_URL=http://worker-runtime:8090
BACKEND_RUNTIME_TOKEN=
BACKEND_LANGGRAPH_SERVICE_TOKEN=
BACKEND_MODEL_ROUTER_URL=http://model-router:8181
BACKEND_MODEL_ROUTER_TOKEN=
BACKEND_APPLICATION_ID_PREFIX=app
BACKEND_ROOM_TOKEN_SECRET=
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LangGraph service
LANGGRAPH_API_TITLE=AI Multiplayer Chat LangGraph Service
LANGGRAPH_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/langgraph
LANGGRAPH_REDIS_URL=redis://redis:6379/0
LANGGRAPH_OLLAMA_PRIMARY_MODEL=kimi-k2.7-code:cloud
LANGGRAPH_OLLAMA_FALLBACK_CLOUD_MODEL=gpt-oss:120b-cloud
LANGGRAPH_MODEL_ROUTER_URL=http://model-router:8181
LANGGRAPH_MODEL_ROUTER_TOKEN=
LANGGRAPH_WORKER_RUNTIME_URL=http://worker-runtime:8090
LANGGRAPH_CODEX_RUNTIME_URL=http://codex-runtime:8090
LANGGRAPH_CLAUDE_RUNTIME_URL=http://claude-runtime:8090
LANGGRAPH_OPENCODE_RUNTIME_URL=http://opencode-runtime:8090
LANGGRAPH_PI_RUNTIME_URL=http://pi-runtime:8090
LANGGRAPH_RUNTIME_TOKEN=
LANGGRAPH_SERVICE_TOKEN=
FIELDWORK_RUNTIME_TOKEN=
FIELDWORK_LANGGRAPH_TOKEN=
FIELDWORK_MODEL_ROUTER_TOKEN=
FIELDWORK_ROOM_TOKEN_SECRET=
LANGGRAPH_AGENT_PROMPT_MANIFEST_PATH=agent_prompts/system_prompt.yaml
LANGGRAPH_AGENT_PROMPT_HUB_IDENTIFIER=
LANGGRAPH_AGENT_SYSTEM_PROMPT_FALLBACK=You are Moss, a dependable digital worker. Report outcomes and deliverables in plain language.
LANGGRAPH_LANGSMITH_TRACING=true
LANGGRAPH_LANGSMITH_PROJECT=ai-multiplayer-chat
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend
VITE_BACKEND_HTTP_URL=http://localhost:18000
VITE_BACKEND_WS_URL=ws://localhost:18000

# Compose ports/images
POSTGRES_PORT=15432
REDIS_PORT=16379
DYNAMODB_PORT=18001
BACKEND_PORT=18000
LANGGRAPH_PORT=8080
FRONTEND_PORT=5173
BACKEND_IMAGE=ai-multiplayer-chat/backend:local
LANGGRAPH_IMAGE=ai-multiplayer-chat/langgraph-service:local
FRONTEND_IMAGE=ai-multiplayer-chat/frontend:local
WORKER_RUNTIME_IMAGE=ai-multiplayer-chat/worker-runtime:local
MODEL_ROUTER_IMAGE=ai-multiplayer-chat/model-router:local

# Platform model router
MODEL_ROUTER_OLLAMA_CLOUD_URL=http://host.docker.internal:11434
MODEL_ROUTER_PRIMARY_MODEL=kimi-k2.7-code:cloud
MODEL_ROUTER_FALLBACK_MODEL=gpt-oss:120b-cloud
MODEL_ROUTER_CHATGPT_MODEL=gpt-5.3-codex
MODEL_ROUTER_CLAUDE_MODEL=claude-sonnet-4-6

# Optional Telegram voice-note gateway (`docker compose --profile telegram up`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
FRONTEND_PUBLIC_URL=http://localhost:5173
OPENAI_API_KEY=
TELEGRAM_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TELEGRAM_HARNESS=langgraph

# Optional first-party Claude Code subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
